# Mascord systemd unit (system service).
#
# Install:
#   sudo cp systemd/mascord.service /etc/systemd/system/mascord.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mascord
#
# Adjust User= / paths if your checkout or account differs.
#
# Build the binary first (from mascord/):
#   CARGO_TARGET_DIR=target cargo build --release

[Unit]
Description=Mascord Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lkless
Group=lkless
WorkingDirectory=/home/lkless/server/mascord

# Mascord loads .env from WorkingDirectory via dotenvy (no EnvironmentFile needed).
Environment=REGISTER_COMMANDS=false

ExecStartPre=/usr/bin/mkdir -p /home/lkless/server/mascord/data
ExecStart=/home/lkless/server/mascord/target/release/mascord

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
